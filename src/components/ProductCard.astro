---
import type { Product } from "../data/products";
import { buildProductWhatsAppLink } from "../config/business";

export interface Props {
  product: Product;
}

const { product } = Astro.props;
const priceFormatted =
  typeof product.price === "number"
    ? product.price.toLocaleString("es-AR", { style: "currency", currency: "ARS" })
    : null;
---

<article class="card flex flex-col overflow-hidden p-0">
  <img
    src={product.image}
    alt={product.name}
    width="400"
    height="300"
    loading="lazy"
    decoding="async"
    class="h-44 w-full object-cover"
  />
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-base font-semibold text-neutral-900">{product.name}</h3>
    <p class="mt-1 flex-1 text-sm text-neutral-600">{product.description}</p>
    <div class="mt-4 flex items-center justify-between">
      <span class="text-sm font-semibold text-brand-700">
        {priceFormatted ?? "Consultar precio"}
      </span>
      <a
        href={buildProductWhatsAppLink(product.name)}
        target="_blank"
        rel="noopener noreferrer"
        data-ga-event="click_product"
        class="text-sm font-semibold text-brand-700 hover:text-brand-800"
      >
        Consultar →
      </a>
    </div>
  </div>
</article>
