---
import { categories } from "../data/categories";
import { business } from "../config/business";

const year = new Date().getFullYear();
---

<footer class="border-t border-brand-900 bg-brand-800 text-brand-50">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-4 lg:px-8">
    <div>
      <p class="text-lg font-bold text-white">{business.BUSINESS_NAME}</p>
      <p class="mt-3 text-sm text-brand-100">{business.SHORT_DESCRIPTION}</p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Navegación</h3>
      <ul class="mt-3 space-y-2 text-sm text-brand-100">
        <li><a href="#inicio" class="hover:text-brand-700">Inicio</a></li>
        <li><a href="#productos" class="hover:text-brand-700">Productos</a></li>
        <li><a href="#nosotros" class="hover:text-brand-700">Nosotros</a></li>
        <li><a href="#faq" class="hover:text-brand-700">Preguntas frecuentes</a></li>
        <li><a href="#contacto" class="hover:text-brand-700">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Categorías</h3>
      <ul class="mt-3 space-y-2 text-sm text-brand-100">
        {categories.slice(0, 5).map((c) => <li>{c.name}</li>)}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Contacto</h3>
      <ul class="mt-3 space-y-2 text-sm text-brand-100">
        <li>{business.ADDRESS}, {business.CITY}</li>
        <li>{business.PHONE_DISPLAY}</li>
        {business.INSTAGRAM_URL && <li><a href={business.INSTAGRAM_URL} class="hover:text-brand-700">Instagram</a></li>}
        {business.OPENING_HOURS_DISPLAY.map((h) => <li>{h.days}: {h.hours}</li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-700 py-5 text-center text-xs text-brand-200">
    © {year} {business.BUSINESS_NAME}. Todos los derechos reservados.
  </div>
</footer>
