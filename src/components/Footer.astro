---
import { categories } from "../data/categories";
import { business } from "../config/business";
import { IconMapPin, IconPhone, IconBrandInstagram, IconClock } from "@tabler/icons-astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-brand-900 bg-brand-800 text-brand-50">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-4 lg:px-8">
    <div>
      <div class="flex items-center gap-2">
        <img src="/images/logoMundo.png" alt={`Logo de ${business.BUSINESS_NAME}`} class="h-12 w-12" />
        <p class="text-lg font-bold text-white">{business.BUSINESS_NAME}</p>
      </div>
      <p class="mt-3 text-sm text-brand-100">{business.SHORT_DESCRIPTION}</p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Navegación</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-brand-100">
        <li><a href="#inicio" class="hover:text-white">Inicio</a></li>
        <li><a href="#productos" class="hover:text-white">Productos</a></li>
        <li><a href="#nosotros" class="hover:text-white">Nosotros</a></li>
        <li><a href="#faq" class="hover:text-white">Preguntas frecuentes</a></li>
        <li><a href="#contacto" class="hover:text-white">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Categorías</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-brand-100">
        {categories.slice(0, 5).map((c) => <li>{c.name}</li>)}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-white">Contacto</h3>

      <ul class="mt-4 space-y-3 text-sm text-brand-100">
        <li class="flex items-start gap-2">
          <IconMapPin size={18} class="mt-0.5 shrink-0 text-brand-200" />
          <span>{business.ADDRESS}, {business.CITY}</span>
        </li>
        <li class="flex items-start gap-2">
          <IconPhone size={18} class="mt-0.5 shrink-0 text-brand-200" />
          <a href={`tel:+54${business.PHONE}`} class="hover:text-white">{business.PHONE_DISPLAY}</a>
        </li>
        {
          business.INSTAGRAM_URL && (
            <li class="flex items-start gap-2">
              <IconBrandInstagram size={18} class="mt-0.5 shrink-0 text-brand-200" />
              <a href={business.INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white">
                Instagram
              </a>
            </li>
          )
        }
      </ul>

      <div class="mt-5 border-t border-brand-700 pt-4">
        <h4 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-brand-200">
          <IconClock size={16} />
          Horarios
        </h4>
        <ul class="mt-2 space-y-1.5 text-sm text-brand-100">
          {business.OPENING_HOURS_DISPLAY.map((h) => <li>{h.days}: {h.hours}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-brand-700 py-5 text-center text-xs text-brand-200">
    © {year} {business.BUSINESS_NAME}. Todos los derechos reservados.
  </div>
</footer>