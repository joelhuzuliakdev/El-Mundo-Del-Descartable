---
import { IconStar } from "@tabler/icons-astro";

const testimonials = [
    { text: "Excelente atención y muy buen surtido de productos.", author: "Cliente de Río Segundo" },
    { text: "Muy completo y la atención es excelente.", author: "Cliente de Río Segundo" },
];
---

<section class="section">
    <div class="flex items-center gap-3">
        <h2 class="section-title">Lo que dicen nuestros clientes</h2>
        <span class="flex items-center gap-1 rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-700">
        <IconStar size={16} class="fill-brand-700" />
        4.9 en Google
        </span>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
        testimonials.map((t) => (
            <blockquote class="card">
            <p class="text-neutral-700">"{t.text}"</p>
            <footer class="mt-3 text-sm font-medium text-neutral-500">— {t.author}</footer>
            </blockquote>
        ))
        }
    </div>
</section>