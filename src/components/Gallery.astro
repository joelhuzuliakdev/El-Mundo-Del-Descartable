---
const photos = [
    { src: "/images/local/localFrente.webp", alt: "Local de El Mundo Del Descartable" },
    { src: "/images/local/muestrarioFrente.webp", alt: "Estanterías con productos descartables" },
    { src: "/images/local/libreria.webp", alt: "Mostrador de atención al cliente" },
    { src: "/images/local/muestrarioCajas.webp", alt: "Productos descartables disponibles" },
];
---

<section class="section bg-neutral-50/60">
    <h2 class="section-title">Conocé nuestro local</h2>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
        photos.map((p) => (
            <img
            src={p.src}
            alt={p.alt}
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
            class="h-40 w-full rounded-lg object-cover sm:h-48"
            />
        ))
        }
    </div>
</section>